# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (PostgreSQL for production / ai-engine)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialiq"

# Security & Authentication
SECRET_KEY="socialiq-jwt-super-secret-key-change-in-production"

# API Base URL
NEXT_PUBLIC_API_URL=""

# Trained Sentiment Model Path (RoBERTa TweetEval)
MODEL_PATH="ai-engine/models/sentiment"

# Social Media Integration Credentials (Optional: if empty, runs in marked DEMO DATA mode)
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
TELEGRAM_BOT_TOKEN=""
INSTAGRAM_ACCESS_TOKEN=""
FACEBOOK_ACCESS_TOKEN=""

